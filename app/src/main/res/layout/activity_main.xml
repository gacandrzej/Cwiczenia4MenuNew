<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 1. Dołączenie nagłówka/toolbara -->
    <include
        android:id="@+id/layoutActionBar"
        layout="@layout/layout_action_bar" />

    <!-- 2. Etykieta nad polem wprowadzania -->
    <TextView
        android:id="@+id/textViewPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="24dp"
        android:layout_marginTop="280dp"
        android:text="Podaj liczbę (dla metody Newtona-Raphsona):"
        android:textSize="16sp" />

    <!-- 3. Pole wprowadzania punktów -->
    <EditText
        android:id="@+id/iloscPunktow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textViewPrompt"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:hint="Wpisz liczbę do pierwiastkowania"
        android:inputType="numberDecimal"
        android:minHeight="48dp" />

    <TextView
        android:id="@+id/textViewPrompt2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/iloscPunktow"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:text="Podaj precyzję:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/precyzja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textViewPrompt2"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:hint="Wpisz liczbę w formacie np.: 0.001"
        android:inputType="numberDecimal"
        android:minHeight="48dp" />
    <!-- 4. Przycisk Newton-Raphson (po kliknięciu przechodzi do nowej aktywności) -->
    <Button
        android:id="@+id/btnnewtonraphson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/precyzja"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:text="Oblicz metodą Newtona-Raphsona" />

    <!-- 5. Przycisk Losuj 6 liczb (umieszczony na dole ekranu) -->
    <Button
        android:id="@+id/button1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:onClick="LosujLiczby"
        android:text="Losuj 6 liczb" />

</RelativeLayout>